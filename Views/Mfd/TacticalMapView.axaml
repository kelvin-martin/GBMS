<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             xmlns:views="using:GBMS.Views.Mfd"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GBMS.Views.Mfd.TacticalMapView">

    <Grid>
        <!-- Tactical map -->
        <mapsui:MapControl x:Name="MapControl" />

        <!-- Speed editing overlay -->
        <views:SpeedEditPanel x:Name="SpeedEditPanel"
                              IsVisible="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,50" />

        <!-- Route Manager overlay -->
        <views:RouteManagerControl
            x:Name="RouteManagerControl"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="100,0,0,50"
            IsVisible="False" />

        <!-- Tactical Map function indicators -->
        <Grid RowDefinitions="*,*,*,*,*,*"
              IsHitTestVisible="False">

            <!-- L1 - Centre on Own Vehicle -->
            <Border Grid.Row="0"
                    x:Name="CentreVehicleIndicator"
                    Width="64"
                    Height="64"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsVisible="True">

                <Image x:Name="CentreVehicleIcon"
                       Source="/Assets/Icons/centre_vehicle.png"
                       Stretch="Uniform"/>
            </Border>

            <!-- L2 - Route Creation -->
            <Border Grid.Row="1" x:Name="RouteCreationIndicator"
                    Width="64"
                    Height="64"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsVisible="True">

                <Image x:Name="RouteCreationIcon"
                       Source="/Assets/Icons/route_creation.png"
                       Stretch="Uniform"/>
            </Border>

            <!-- L3 - Route Manager -->
            <Border Grid.Row="2"
                    x:Name="RouteManagerIndicator"
                    Width="64"
                    Height="64"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsVisible="True">

                <Image x:Name="RouteManagerIcon"
                       Source="/Assets/Icons/routes.png"
                       Stretch="Uniform"/>
            </Border>

            <!-- L3 - Speed Increase -->
            <Border x:Name="L3ContextIcon"
                    Grid.Row="2"
                    Width="64"
                    Height="64"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsVisible="False">

                <Image Source="/Assets/Icons/increase.png"
                       Stretch="Uniform"/>
            </Border>

            <!-- L4 - Speed Decrease -->
            <Border x:Name="L4ContextIcon"
                    Grid.Row="3"
                    Width="64"
                    Height="64"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsVisible="False">

                <Image Source="/Assets/Icons/decrease.png"
                       Stretch="Uniform"/>
            </Border>

        </Grid>
    </Grid>

</UserControl>
