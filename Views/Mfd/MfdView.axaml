<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GBMS.ViewModels.Mfd"
             xmlns:views="using:GBMS.Views.Mfd"
             x:DataType="vm:MfdViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GBMS.Views.Mfd.MfdView">

    <UserControl.Styles>


        <Style Selector="Button.MfdPower">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#70C070"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style Selector="Button.MfdPower:pointerover">
            <Setter Property="Background" Value="#303030"/>
        </Style>

        <Style Selector="Button.MfdPower:pressed">
            <Setter Property="Background" Value="#404040"/>
        </Style>


        <Style Selector="Button.MfdKey">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style Selector="Border.statusIndicator">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Width" Value="65"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="4,2,4,0"/>
        </Style>

        <Style Selector="Button.MfdKey:pointerover">
            <Setter Property="Background" Value="#303030"/>
        </Style>

        <Style Selector="Button.MfdKey:pressed">
            <Setter Property="Background" Value="#404040"/>
        </Style>

        <Style Selector="Button.MfdKey:disabled">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="BorderBrush" Value="#202020"/>
        </Style>

    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:MfdPlaceholderViewModel">
            <TextBlock Text="{Binding Title}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="32"
                       FontWeight="Bold"/>
        </DataTemplate>

    </UserControl.DataTemplates>

    <Border Background="#101010"
            Padding="8">

        <Grid RowDefinitions="64,*,64"
              ColumnDefinitions="72,*,72">

            <!-- ========================================================= -->
            <!-- Power                                                       -->
            <!-- ========================================================= -->

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Content="⏻"
                    Classes="MfdPower"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="OnPowerClick"/>

            <!-- ========================================================= -->
            <!-- Top functional-area keys                                  -->
            <!-- ========================================================= -->

            <Grid Grid.Row="0"
                  Grid.Column="1"
                  ColumnDefinitions="*,*,*,*,*,*,*,*"
                  Margin="0,0,0,6">

                <StackPanel Grid.Column="0">

                    <Button Content="SA"
                            Classes="MfdKey"
                            Click="OnGva1Click"/>
                    <Border x:Name="SaStatusIndicator"
                            Classes="statusIndicator"/>

                </StackPanel>

                <StackPanel Grid.Column="1">

                    <Button Content="WPN"
                            Classes="MfdKey"
                            Click="OnGva2Click"/>
                    <Border x:Name="WpnStatusIndicator"
                            Classes="statusIndicator"/>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Button Content="DEF"
                            Classes="MfdKey"
                            Click="OnGva3Click"/>
                    <Border x:Name="DefStatusIndicator"
                            Classes="statusIndicator"/>

                </StackPanel>

                <StackPanel Grid.Column="3">

                    <Button Content="SYS"
                            Classes="MfdKey"
                            Click="OnGva4Click"/>
                    <Border x:Name="SysStatusIndicator"
                            Classes="statusIndicator"/>

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <Button Content="DRV"
                            Classes="MfdKey"
                            Click="OnGva5Click"/>
                    <Border x:Name="DrvStatusIndicator"
                            Classes="statusIndicator"/>

                </StackPanel>

                <StackPanel Grid.Column="5">

                    <Button
                        Content="STR"
                        Classes="MfdKey"
                        Click="OnGva6Click"/>
                    <Border x:Name="StrStatusIndicator"
                            Classes="statusIndicator"/>

                </StackPanel>

                <StackPanel Grid.Column="6">
                    <Button
                        Content="COM"
                        Classes="MfdKey"
                        Click="OnGva7Click"/>
                    <Border x:Name="ComStatusIndicator"
                            Classes="statusIndicator"/>

                </StackPanel>

                <StackPanel Grid.Column="7">
                    <Button
                        Content="BMS"
                        Classes="MfdKey"
                        Click="OnGva8Click"/>
                    <Border x:Name="BmsStatusIndicator"
                            Classes="statusIndicator"/>
                </StackPanel>

            </Grid>


            <!-- ========================================================= -->
            <!-- Left contextual keys                                        -->
            <!-- ========================================================= -->

            <Grid Grid.Row="1"
                  Grid.Column="0"
                  RowDefinitions="*,*,*,*,*,*"
                  Margin="0,0,6,0">

                <Button Grid.Row="0"
                        Content="L1"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnL1Click"/>

                <Button Grid.Row="1"
                        Content="L2"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnL2Click"/>

                <Button Grid.Row="2"
                        Content="L3"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnL3Click"/>

                <Button Grid.Row="3"
                        Content="L4"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnL4Click"/>

                <Button Grid.Row="4"
                        Content="L5"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnL5Click"/>

                <Button Grid.Row="5"
                        Content="L6"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnL6Click"/>

            </Grid>


            <!-- ========================================================= -->
            <!-- Central display area                                        -->
            <!-- ========================================================= -->

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="Black"
                    BorderBrush="#555555"
                    BorderThickness="1">

                <Grid RowDefinitions="48,*,42">

                    <!-- ================================================ -->
                    <!-- Persistent system header                          -->
                    <!-- ================================================ -->

                    <Border Grid.Row="0"
                            Background="#151515"
                            BorderBrush="#404040"
                            BorderThickness="0,0,0,1"
                            Padding="12,0">

                        <Grid ColumnDefinitions="*,Auto,*">

                            <TextBlock Grid.Column="0"
                                       Text="GBMS"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#E0E0E0"/>

                            <TextBlock Grid.Column="1"
                                       Text="SYSTEM"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#E0E0E0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding SimulationTime}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="14"
                                       Foreground="#E0E0E0"/>

                        </Grid>

                    </Border>


                    <!-- ================================================ -->
                    <!-- Application content                               -->
                    <!-- ================================================ -->

                    <Border Grid.Row="1"
                            Padding="12">

                        <Grid>

                            <!-- Existing subsystem content -->
                            <ContentControl x:Name="ContentArea"
                                            Content="{Binding CurrentContentViewModel}" />

                            <!-- Persistent Tactical Map -->
                            <views:TacticalMapView x:Name="TacticalMapView"
                                                   IsVisible="False" />

                        </Grid>

                    </Border>


                    <!-- ================================================ -->
                    <!-- Alarm area                                         -->
                    <!-- ================================================ -->

                    <Border Grid.Row="2"
                            Background="#101010"
                            BorderBrush="#404040"
                            BorderThickness="0,1,0,0"
                            Padding="12,0">

                        <TextBlock Text="NO ACTIVE WARNINGS"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#70C070"/>

                    </Border>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- Right contextual keys                                       -->
            <!-- ========================================================= -->

            <Grid Grid.Row="1"
                  Grid.Column="2"
                  RowDefinitions="*,*,*,*,*,*"
                  Margin="6,0,0,0">

                <Button Grid.Row="0"
                        Content="R1"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnR1Click"/>

                <Button Grid.Row="1"
                        Content="R2"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnR2Click"/>

                <Button Grid.Row="2"
                        Content="R3"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnR3Click"/>

                <Button Grid.Row="3"
                        Content="R4"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnR4Click"/>

                <Button Grid.Row="4"
                        Content="R5"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnR5Click"/>

                <Button Grid.Row="5"
                        Content="R6"
                        Classes="MfdKey"
                        Height="64"
                        Click="OnR6Click"/>

            </Grid>


            <!-- ========================================================= -->
            <!-- Bottom global keys                                          -->
            <!-- ========================================================= -->

            <Grid Grid.Row="2"
                  Grid.Column="1"
                  ColumnDefinitions="*,*,*,*,*,*,*,*"
                  Margin="0,6,0,0">

                <Button Grid.Column="0"
                        Content="F12"
                        Classes="MfdKey"/>

                <Button Grid.Column="1"
                        Content="F14"
                        Classes="MfdKey"/>

                <Button Grid.Column="2"
                        Content="F13"
                        Classes="MfdKey"/>

                <Button Grid.Column="3"
                        Content="F14"
                        Classes="MfdKey"/>

                <Button Grid.Column="4"
                        Content="F15"
                        Classes="MfdKey"/>

                <Button Grid.Column="5"
                        Content="F16"
                        Classes="MfdKey"/>

                <Button Grid.Column="6"
                        Content="F17"
                        Classes="MfdKey"/>

                <Button Grid.Column="7"
                        Content="F18"
                        Classes="MfdKey"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>

